# Local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/citetrack

# Docker Compose (uncomment if using docker compose)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/citetrack

# Required
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Passage matching strategy: "api" (Claude API) or "agent" (Claude Agent SDK)
MATCHER_STRATEGY=api

# Required when MATCHER_STRATEGY=api
ANTHROPIC_API_KEY=

# Optional — Unpaywall uses this for rate limit identification
UNPAYWALL_EMAIL=
