# Local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/citetrack

# Docker Compose (uncomment if using docker compose)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/citetrack

# Required
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Claude matching strategy (shared by citation passage matching and the EYD
# evaluation step):
#   "none"  (default) - no Claude calls at all. Citation passage matching is
#                       disabled; EYD evaluation runs rules-only.
#   "api"             - direct Anthropic SDK. Requires ANTHROPIC_API_KEY.
#   "agent"           - Claude Agent SDK. Requires ANTHROPIC_API_KEY and a
#                       Claude Agent-capable account.
MATCHER_STRATEGY=none

# Required when MATCHER_STRATEGY is "api" or "agent"
ANTHROPIC_API_KEY=

# Optional — Unpaywall uses this for rate limit identification
UNPAYWALL_EMAIL=

# Optional — CORE API key for open access paper search (https://core.ac.uk/services/api)
CORE_API_KEY=
